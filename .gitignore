# Org exports and user-supplied inputs: never committed
data/
/ai-context/

# Maintainers' private specs and plans; kept out even without a personal global ignore
/docs/superpowers/

# Generated index: rebuilt in CI, never trusted from git.
# Anchored with "/": a bare "index/" also ignores tools/index/, the index builder itself.
/index/

# Rendered rules entry point; render.py --check needs it. Un-ignored here because a
# personal global gitignore that lists CLAUDE.md would otherwise keep it out of commits.
!/CLAUDE.md

# Tool state
.sf/
.sfdx/
node_modules/
__pycache__/

# Personal Claude Code overrides (mode switch); never committed
.claude/settings.local.json
