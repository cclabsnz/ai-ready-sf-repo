<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Last_Review_Date_Not_Ancient</fullName>
    <active>true</active>
    <description>Keeps last review date on Account records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Last_Review_Date__c)), Last_Review_Date__c &lt; DATE(2000, 1, 1))</errorConditionFormula>
    <errorDisplayField>Last_Review_Date__c</errorDisplayField>
    <errorMessage>Last Review Date cannot be before the year 2000.</errorMessage>
</ValidationRule>
