<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Seat_Count_Not_Negative</fullName>
    <active>true</active>
    <description>Keeps seat count on Account records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Seat_Count__c)), Seat_Count__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Seat_Count__c</errorDisplayField>
    <errorMessage>Seat Count cannot be negative.</errorMessage>
</ValidationRule>
