<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Churn_Risk_Pct_In_Range</fullName>
    <active>true</active>
    <description>Keeps churn risk pct on Account records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Churn_Risk_Pct__c)), OR(Churn_Risk_Pct__c &lt; 0, Churn_Risk_Pct__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Churn_Risk_Pct__c</errorDisplayField>
    <errorMessage>Churn Risk Pct must be between 0 and 100.</errorMessage>
</ValidationRule>
