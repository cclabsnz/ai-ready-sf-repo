<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contract_Term_Months_Not_Negative</fullName>
    <active>true</active>
    <description>Keeps contract term months on Opportunity records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Contract_Term_Months__c)), Contract_Term_Months__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Contract_Term_Months__c</errorDisplayField>
    <errorMessage>Contract Term Months cannot be negative.</errorMessage>
</ValidationRule>
