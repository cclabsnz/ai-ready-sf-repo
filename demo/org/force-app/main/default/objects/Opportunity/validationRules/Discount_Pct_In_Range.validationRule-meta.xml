<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Discount_Pct_In_Range</fullName>
    <active>true</active>
    <description>Keeps discount pct on Opportunity records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Discount_Pct__c)), OR(Discount_Pct__c &lt; 0, Discount_Pct__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Discount_Pct__c</errorDisplayField>
    <errorMessage>Discount Pct must be between 0 and 100.</errorMessage>
</ValidationRule>
