<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Deal_Risk_Score_In_Range</fullName>
    <active>true</active>
    <description>Keeps deal risk score on Opportunity records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Deal_Risk_Score__c)), OR(Deal_Risk_Score__c &lt; 0, Deal_Risk_Score__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Deal_Risk_Score__c</errorDisplayField>
    <errorMessage>Deal Risk Score must be between 0 and 100.</errorMessage>
</ValidationRule>
