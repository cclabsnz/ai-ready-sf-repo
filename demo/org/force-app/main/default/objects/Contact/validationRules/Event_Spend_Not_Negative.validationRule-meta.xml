<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Event_Spend_Not_Negative</fullName>
    <active>true</active>
    <description>Keeps event spend on Contact records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Event_Spend__c)), Event_Spend__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Event_Spend__c</errorDisplayField>
    <errorMessage>Event Spend cannot be negative.</errorMessage>
</ValidationRule>
