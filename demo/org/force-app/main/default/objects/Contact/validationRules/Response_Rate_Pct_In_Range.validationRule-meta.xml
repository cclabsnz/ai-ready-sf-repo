<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Response_Rate_Pct_In_Range</fullName>
    <active>true</active>
    <description>Keeps response rate pct on Contact records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Response_Rate_Pct__c)), OR(Response_Rate_Pct__c &lt; 0, Response_Rate_Pct__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Response_Rate_Pct__c</errorDisplayField>
    <errorMessage>Response Rate Pct must be between 0 and 100.</errorMessage>
</ValidationRule>
