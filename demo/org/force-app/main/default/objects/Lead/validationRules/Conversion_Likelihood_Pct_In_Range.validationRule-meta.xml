<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Conversion_Likelihood_Pct_In_Range</fullName>
    <active>true</active>
    <description>Keeps conversion likelihood pct on Lead records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Conversion_Likelihood_Pct__c)), OR(Conversion_Likelihood_Pct__c &lt; 0, Conversion_Likelihood_Pct__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Conversion_Likelihood_Pct__c</errorDisplayField>
    <errorMessage>Conversion Likelihood Pct must be between 0 and 100.</errorMessage>
</ValidationRule>
