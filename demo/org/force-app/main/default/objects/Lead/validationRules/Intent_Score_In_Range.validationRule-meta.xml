<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Intent_Score_In_Range</fullName>
    <active>true</active>
    <description>Keeps intent score on Lead records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Intent_Score__c)), OR(Intent_Score__c &lt; 0, Intent_Score__c &gt; 100))</errorConditionFormula>
    <errorDisplayField>Intent_Score__c</errorDisplayField>
    <errorMessage>Intent Score must be between 0 and 100.</errorMessage>
</ValidationRule>
