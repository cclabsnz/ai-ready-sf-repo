<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Trial_Start_Date_Not_Ancient</fullName>
    <active>true</active>
    <description>Keeps trial start date on Lead records within a sensible range.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Trial_Start_Date__c)), Trial_Start_Date__c &lt; DATE(2000, 1, 1))</errorConditionFormula>
    <errorDisplayField>Trial_Start_Date__c</errorDisplayField>
    <errorMessage>Trial Start Date cannot be before the year 2000.</errorMessage>
</ValidationRule>
