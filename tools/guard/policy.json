{
  "version": 1,
  "blocked_commands": [
    "(^|\\s|/)sfdx(\\s|$)",
    "\\bgit\\s+push\\b",
    "\\bgit\\s+commit\\b.*--amend",
    "\\bcurl\\b",
    "\\bwget\\b",
    "\\bssh\\b",
    "\\bscp\\b",
    "\\bInvoke-WebRequest\\b",
    "(?<![A-Za-z0-9_])guard\\.py",
    "--rebaseline"
  ],
  "unknown_writers": [
    "sh",
    "bash",
    "zsh",
    "eval",
    "xargs",
    "env",
    "nohup",
    "perl",
    "ruby",
    "node",
    "exec",
    "command",
    "builtin",
    "source",
    ".",
    "sudo",
    "doas",
    "time",
    "timeout",
    "nice",
    "setsid",
    "stdbuf",
    "rsync",
    "patch",
    "tar",
    "unzip",
    "awk",
    "gawk",
    "ln",
    "link",
    "unlink",
    "trap",
    "alias",
    "coproc",
    "noglob",
    "nocorrect",
    "caffeinate",
    "arch",
    "script",
    "osascript",
    "ed",
    "ex",
    "vi",
    "vim",
    "ditto",
    "plutil",
    "cpio",
    "pax",
    "function",
    "export",
    "declare",
    "typeset",
    "readonly",
    "local",
    "set"
  ],
  "git_allowed": [
    "status",
    "diff",
    "log",
    "show",
    "rev-parse",
    "ls-files",
    "check-ignore",
    "blame",
    "branch",
    "add",
    "commit"
  ],
  "fetch_allowlist": [
    "help.salesforce.com",
    "developer.salesforce.com",
    "releasenotes.docs.salesforce.com",
    "docs.ncino.com"
  ],
  "tools": {
    "read_only": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "TodoWrite",
      "WebSearch",
      "Task",
      "Agent",
      "ToolSearch",
      "BashOutput",
      "KillShell",
      "NotebookRead",
      "ExitPlanMode",
      "EnterPlanMode",
      "AskUserQuestion",
      "Skill",
      "SlashCommand",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "TaskStop",
      "ScheduleWakeup",
      "ListAgents",
      "SendMessage"
    ],
    "mcp_write_pattern": "(?i)(write|edit|create|delete|remove|move|rename|update|upload|send|post|put|patch|apply|push|deploy|trash|forward|reply|label|archive|set|add|insert|execute|run|install|copy|save|store|commit|merge|mkdir|upsert|cancel|untrash|unlabel|mark|unmark|respond|pause|resume|approve|accept|revoke|rollback|promote|buy|invalidate|stop|kill|transfer|share|assign|schedule|enable|disable|activate|input|fill|submit|click|type|navigate|upgrade|restore)"
  },
  "tripwire_paths": [
    "tools/guard",
    ".claude/settings.json",
    ".github/workflows",
    ".github/hooks",
    ".github/CODEOWNERS",
    "CODEOWNERS"
  ],
  "always_blocked_writes": [
    "tools/guard/",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".github/workflows/",
    ".github/hooks/",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    ".git/",
    "ai-context/.active-story"
  ],
  "modes": {
    "advise": {
      "writes": [],
      "bash_allow": [
        "read_only"
      ]
    },
    "normal": {
      "writes": [
        "ai-context/",
        "index/"
      ],
      "bash_allow": [
        "read_only",
        "framework_scripts"
      ]
    },
    "build": {
      "writes": [
        "ai-context/",
        "index/"
      ],
      "scoped_source": true,
      "bash_allow": [
        "read_only",
        "framework_scripts",
        "dev_tooling"
      ]
    },
    "maintain": {
      "writes": [
        "framework/",
        "tools/",
        "fixtures/",
        "demo/",
        "docs/",
        "impacts/",
        "CLAUDE.md",
        ".claude/knowledge/",
        ".claude/skills/",
        ".claude/agents/",
        ".github/instructions/",
        ".github/knowledge/",
        ".github/skills/",
        ".github/agents/",
        "README.md",
        "HANDOFF.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        ".ai-framework.json",
        "ai-context/",
        "index/"
      ],
      "bash_allow": [
        "read_only",
        "framework_scripts",
        "maintainer_tools"
      ]
    }
  },
  "bash_groups": {
    "read_only": [
      "(cat|ls|dir|head|tail|wc|pwd|echo|grep|diff|cd)(\\s.*)?",
      "rg(\\s+(?!--pre|--hostname-bin)\\S+)*",
      "sort(\\s+(?!-[A-Za-z]*o|--o|--c)\\S+)*",
      "git\\s+(status|diff|log|show|rev-parse|ls-files|check-ignore|blame)(\\s+(?!--ou)\\S+)*",
      "git\\s+branch\\s+--show-current",
      "find(\\s+(?!-(delete|exec|execdir|ok|okdir|fprint|fprint0|fprintf|fls)(\\s|$))\\S+)*",
      "python3?\\s+tools/index/query\\.py(\\s.*)?",
      "py\\s+-3\\s+tools/index/query\\.py(\\s.*)?",
      "(python3?|py -3)\\s+tools/impacts/register\\.py(\\s.*)?"
    ],
    "framework_scripts": [
      "(python3?|py -3) tools/index/(build_index|query|test_index)\\.py( .*)?",
      "(python3?|py -3) tools/evals/run_(skill|agent)\\.py( .*)?",
      "(python3?|py -3) tools/build/lint\\.py( .*)?",
      "(python3?|py -3) tools/guard/(test_guard|scan_data)\\.py( .*)?",
      "(python3?|py -3) tools/impacts/(validate|render_register|pr_check)\\.py( .*)?",
      "(python3?|py -3) tools/stories/(validate_story|check_ac)\\.py( .*)?",
      "(python3?|py -3) tools/designs/validate_design\\.py( .*)?",
      "(python3?|py -3) tools/config/framework_config\\.py( .*)?",
      "(python3?|py -3) tools/code/check_rules\\.py( --from-config)?( --compare-baseline [A-Za-z0-9_.][A-Za-z0-9_./-]*)?",
      "(python3?|py -3) tools/code/check_trace\\.py( --skeletons)? [A-Z][A-Z0-9]*-[0-9]+",
      "(python3?|py -3) framework/skills/[a-z0-9-]+/scripts/[a-z0-9_]+\\.py( .*)?"
    ],
    "dev_tooling": [
      "git (add|commit)( .*)?",
      "pnpm exec (prettier|eslint|jest|sfdx-lwc-jest)( .*)?",
      "pnpm (run )?(lint|format)",
      "pnpm (run )?test( -- .*)?"
    ],
    "maintainer_tools": [
      "(cp|mv|mkdir|rm|touch|rmdir|sed|diff|cmp)( .*)?",
      "tar -t[a-zA-Z]*( .*)?",
      "(python3?|py -3) (?!(?i:tools/(impacts/start|evals/run_all)\\.py)( |$))(tools|ai-context|framework|fixtures|demo)(/[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*)+\\.py( .*)?",
      "(python3?|py -3) tools/build/render\\.py( .*)?",
      "git (add|commit)( .*)?",
      "pnpm exec (prettier|eslint|jest)( .*)?"
    ]
  },
  "sf": {
    "level_order": [
      "none",
      "offline",
      "org-metadata",
      "org-data"
    ],
    "levels": {
      "none": [],
      "offline": [
        "sf (--version|version)",
        "sf help( .*)?",
        "sf project generate( .*)?",
        "sf apex generate (class|trigger)( .*)?",
        "sf lightning generate (component|app|event|interface|test)( .*)?",
        "sf static-resource generate( .*)?",
        "sf code-analyzer run( .*)?",
        "sf project convert source( .*)?"
      ],
      "org-metadata": [
        "sf sobject (describe|list)( .*)?",
        "sf org list metadata( .*)?",
        "sf org list metadata-types( .*)?",
        "sf project retrieve preview( .*)?"
      ],
      "org-data": [
        "sf data query( .*)?"
      ]
    },
    "org_levels": [
      "org-metadata",
      "org-data"
    ],
    "allowed_orgs": [],
    "mode_level": {
      "advise": "none",
      "normal": "offline",
      "build": "offline",
      "maintain": "offline"
    },
    "always_blocked": [
      "sf (auth|login|logout)( .*)?",
      "sf org (login|logout|display|create|delete|open|resume|generate password|assign permset)( .*)?",
      "sf project deploy( .*)?",
      "sf project retrieve start( .*)?",
      "sf project delete( .*)?",
      "sf (deploy|retrieve)( .*)?",
      "sf apex run( .*)?",
      "sf data (create|update|upsert|delete|import|export|bulk|resume)( .*)?"
    ]
  }
}
