{
  "version": 1,
  "blocked_commands": [
    "(^|\\s|/)sf(dx)?(\\s|$)",
    "\\bgit\\s+push\\b",
    "\\bgit\\s+commit\\b.*--amend",
    "\\bcurl\\b",
    "\\bwget\\b",
    "\\bssh\\b",
    "\\bscp\\b",
    "\\bInvoke-WebRequest\\b"
  ],
  "unknown_writers": [
    "sh", "bash", "zsh", "eval", "xargs", "env", "nohup", "perl", "ruby", "node",
    "exec", "command", "builtin", "source", ".", "sudo", "doas", "time", "timeout", "nice", "setsid", "stdbuf",
    "rsync", "patch", "tar", "unzip", "awk", "gawk",
    "ln", "link", "unlink", "trap", "alias", "coproc", "noglob", "nocorrect", "caffeinate", "arch", "script",
    "osascript", "ed", "ex", "vi", "vim", "ditto", "plutil", "cpio", "pax",
    "function", "export", "declare", "typeset", "readonly", "local", "set"
  ],
  "git_allowed": [
    "status", "diff", "log", "show", "rev-parse", "ls-files", "check-ignore", "blame", "branch", "grep", "add", "commit"
  ],
  "fetch_allowlist": [
    "help.salesforce.com",
    "developer.salesforce.com",
    "releasenotes.docs.salesforce.com",
    "docs.ncino.com"
  ],
  "always_blocked_writes": [
    "tools/guard/",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".github/workflows/",
    ".github/hooks/",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    ".git/"
  ],
  "modes": {
    "advise": {
      "writes": [],
      "bash_allow": ["read_only"]
    },
    "normal": {
      "writes": ["ai-context/", "index/"]
    },
    "build": {
      "writes": ["ai-context/", "index/"],
      "scoped_source": true
    },
    "maintain": {
      "writes": [
        "framework/",
        "tools/",
        "fixtures/",
        "demo/",
        "docs/",
        "impacts/",
        "CLAUDE.md",
        ".claude/knowledge/",
        ".claude/skills/",
        ".claude/agents/",
        ".github/instructions/",
        ".github/knowledge/",
        ".github/skills/",
        ".github/agents/",
        "README.md",
        "HANDOFF.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        ".ai-framework.json",
        "ai-context/",
        "index/"
      ]
    }
  },
  "bash_groups": {
    "read_only": [
      "(cat|ls|dir|head|tail|wc|pwd|echo|grep|diff|cd)(\\s.*)?",
      "rg(\\s+(?!--pre|--hostname-bin)\\S+)*",
      "sort(\\s+(?!-[A-Za-z]*o|--o|--c)\\S+)*",
      "git\\s+(status|diff|log|show|rev-parse|ls-files|check-ignore|blame)(\\s+(?!--ou)\\S+)*",
      "git\\s+branch\\s+--show-current",
      "find(\\s+(?!-(delete|exec|execdir|ok|okdir|fprint|fprint0|fprintf|fls)(\\s|$))\\S+)*",
      "python3?\\s+tools/index/query\\.py(\\s.*)?",
      "py\\s+-3\\s+tools/index/query\\.py(\\s.*)?"
    ]
  }
}
