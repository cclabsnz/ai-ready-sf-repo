{
  "version": 1,
  "blocked_commands": [
    "(^|\\s|/)sf(dx)?(\\s|$)",
    "\\bgit\\s+push\\b",
    "\\bgit\\s+commit\\b.*--amend",
    "\\bcurl\\b",
    "\\bwget\\b",
    "\\bssh\\b",
    "\\bscp\\b",
    "\\bInvoke-WebRequest\\b"
  ],
  "fetch_allowlist": [
    "help.salesforce.com",
    "developer.salesforce.com",
    "releasenotes.docs.salesforce.com",
    "docs.ncino.com"
  ],
  "always_blocked_writes": [
    "tools/guard/",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".github/workflows/",
    ".github/hooks/",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    ".git/"
  ],
  "modes": {
    "advise": {
      "writes": []
    },
    "normal": {
      "writes": ["ai-context/", "index/"]
    },
    "build": {
      "writes": ["ai-context/", "index/"],
      "scoped_source": true
    },
    "maintain": {
      "writes": [
        "framework/",
        "tools/",
        "fixtures/",
        "demo/",
        "docs/",
        "impacts/",
        "CLAUDE.md",
        ".claude/knowledge/",
        ".claude/skills/",
        ".claude/agents/",
        ".github/instructions/",
        ".github/knowledge/",
        ".github/skills/",
        ".github/agents/",
        "README.md",
        "HANDOFF.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        ".ai-framework.json",
        "ai-context/",
        "index/"
      ]
    }
  },
  "bash_groups": {
    "read_only": [
      "cat",
      "ls",
      "dir",
      "git\\s+(status|diff|log|show|rev-parse)",
      "python3?\\s+tools/index/query\\.py",
      "py\\s+-3\\s+tools/index/query\\.py"
    ]
  }
}
