{
  "env": {
    "AI_FRAMEWORK_MODE": "normal"
  },
  "permissions": {
    "deny": [
      "Bash(sf auth*)",
      "Bash(sf login*)",
      "Bash(sf logout*)",
      "Bash(sf org login*)",
      "Bash(sf org logout*)",
      "Bash(sf org display*)",
      "Bash(sf org create*)",
      "Bash(sf org delete*)",
      "Bash(sf org open*)",
      "Bash(sf project deploy*)",
      "Bash(sf project retrieve start*)",
      "Bash(sf project delete*)",
      "Bash(sf deploy*)",
      "Bash(sf retrieve*)",
      "Bash(sf apex run*)",
      "Bash(sf data create*)",
      "Bash(sf data update*)",
      "Bash(sf data upsert*)",
      "Bash(sf data delete*)",
      "Bash(sf data import*)",
      "Bash(sf data export*)",
      "Bash(sf data bulk*)",
      "Bash(sf data resume*)",
      "Bash(sf org resume*)",
      "Bash(sf org generate password*)",
      "Bash(sf org assign permset*)",
      "Bash(sfdx *)",
      "Bash(git push*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch(*)"
    ],
    "allow": [
      "WebFetch(domain:help.salesforce.com)",
      "WebFetch(domain:developer.salesforce.com)",
      "WebFetch(domain:releasenotes.docs.salesforce.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/guard/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
